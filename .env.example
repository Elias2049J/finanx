# ===========================================================================
# Plantilla de configuracion por entorno. SOLO contiene valores de ejemplo:
# ninguno corresponde al despliegue real.
#
# BOOTSTRAP (clon limpio):
#   1. cp .env.example .env
#   2. Reemplaza los valores marcados como REEMPLAZAR por los reales.
#   3. Coloca el service account de Firebase en secrets/ y ajusta
#      FCM_CREDENTIALS_PATH (ver docker-compose.yml para el path que espera
#      el contenedor).
#   4. Crea secrets/seaweedfs_access_key y secrets/seaweedfs_secret_key con
#      las credenciales S3, sin salto de linea final. Docker las monta como
#      secretos; el compose no recibe las claves por variables de entorno.
#   5. docker compose up -d --build
#
# IMPORTANTE:
#   - Este archivo SI se versiona: no debe contener secretos reales.
#   - .env NO se versiona: es el archivo con los valores reales.
#   - Spring lee .env como properties (spring.config.import en
#     application.yml) y docker compose lo carga con env_file: .env.
#   - NO pongas comillas alrededor de los valores: Spring no las quita al
#     leerlos como properties.
#
# Los valores marcados REEMPLAZAR son credenciales. Sin ellas el backend no
# arranca (o la funcion afectada queda inutilizable): Postgres rechaza la
# contrasena, FCM no encuentra el service account y los proveedores externos
# rechazan la clave. Las credenciales S3 se guardan en archivos Docker secrets,
# no en este archivo.
# ===========================================================================


# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
# Puerto del backend. En docker el compose lo publica en 127.0.0.1:8082.
SERVER_PORT=8080

# Entorno logico: development | production. En production el backend falla al
# arrancar si detecta auto-premium, Play Billing fake, Swagger abierto, URLs
# locales o un JWT de ejemplo.
APP_ENV=development

# Zona horaria por defecto para interpretacion de fechas.
APP_TIME_DEFAULT_ZONE=America/Lima

# Documentacion interactiva (Swagger UI / OpenAPI). Apagada por defecto en
# produccion. Para desarrollo local, exporta SPRINGDOC_ENABLED=true.
SPRINGDOC_ENABLED=false


# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
# En docker lo sobreescribe el compose con el host del servicio.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mi_base_de_datos
SPRING_DATASOURCE_USERNAME=mi_usuario
DB_PASSWORD=REEMPLAZAR

# Conexiones del pool de HikariCP. Es el techo real de concurrencia contra
# Postgres: subelo solo si el servidor aguanta.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=50


# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Secreto de firma aleatorio de al menos 32 bytes UTF-8; REEMPLAZAR es rechazado al iniciar.
JWT_SECRET=REEMPLAZAR
JWT_ISSUER=mi-api
JWT_AUDIENCES=mi-api
JWT_EXPIRATION_SECONDS=900
# Opcional: pepper HMAC exclusivo para OTP (mínimo 32 bytes UTF-8).
# Si se omite, el backend deriva el hash usando JWT_SECRET.
# EMAIL_VERIFICATION_HMAC_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_BYTES
# Máximo global de correos de verificación iniciados por minuto en este nodo.
APP_EMAIL_VERIFICATION_GLOBAL_SEND_LIMIT_PER_MINUTE=10


# ---------------------------------------------------------------------------
# Google OAuth (login con Google)
# ---------------------------------------------------------------------------
# El client-id es un identificador publico (va tambien en la app movil);
# lo que no puede salir del repo es el client-secret.
GOOGLE_CLIENT_ID=REEMPLAZAR
GOOGLE_CLIENT_SECRET=REEMPLAZAR
GOOGLE_ISSUER_URI=https://accounts.google.com
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs


# ---------------------------------------------------------------------------
# Subida de archivos (recibos)
# ---------------------------------------------------------------------------
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=20MB


# ---------------------------------------------------------------------------
# Frontend (app movil / web)
# ---------------------------------------------------------------------------
APP_FRONT_URL=http://localhost:4200
APP_FRONT_URL_HTTPS=https://localhost:4200


# ---------------------------------------------------------------------------
# Facturacion
# ---------------------------------------------------------------------------
# Asigna PREMIUM automaticamente a cada usuario nuevo. Es un atajo de
# desarrollo: en produccion debe quedar en false.
APP_BILLING_AUTO_PREMIUM=false
APP_BILLING_WEBHOOKS_ENABLED=false
# Google Play Billing: disabled no permite verificar compras. Usa fake solo
# en desarrollo, con tokens test-valid-*. En produccion debe quedar disabled
# hasta configurar el service account real de Google Play.
APP_BILLING_GOOGLE_PLAY_MODE=disabled
APP_BILLING_GOOGLE_PLAY_PACKAGE_NAME=com.elias.mismonedas
APP_BILLING_GOOGLE_PLAY_MONTHLY_PRODUCT_ID=premium_monthly_test
APP_BILLING_GOOGLE_PLAY_ANNUAL_PRODUCT_ID=premium_annual_test
APP_BILLING_GOOGLE_PLAY_MONTHLY_PRICE=19.90
APP_BILLING_GOOGLE_PLAY_ANNUAL_PRICE=199.00
APP_BILLING_GOOGLE_PLAY_CURRENCY=PEN


# ---------------------------------------------------------------------------
# Gemini (chatbot / insights)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=REEMPLAZAR
APP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
APP_GEMINI_MODEL_PRIMARY=gemini-2.5-flash


# ---------------------------------------------------------------------------
# Currency Beacon (tipos de cambio)
# ---------------------------------------------------------------------------
CURRENCYBEACON_API_KEY=REEMPLAZAR
CURRENCYBEACON_API_URL=https://api.currencybeacon.com/v1


# ---------------------------------------------------------------------------
# Notificaciones por correo (Gmail SMTP)
# ---------------------------------------------------------------------------
APP_NOTIFICATIONS_EMAIL_HOST=smtp.example.com
APP_NOTIFICATIONS_EMAIL_PORT=465
APP_NOTIFICATIONS_EMAIL_FROM=notificaciones@example.com
APP_NOTIFICATIONS_EMAIL_USERNAME=notificaciones@example.com
# "app-password" de Google, no la contrasena de la cuenta.
EMAIL_APP_PASSWORD=REEMPLAZAR


# ---------------------------------------------------------------------------
# Notificaciones push (Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# Ruta del service account JSON dentro del proyecto. El archivo vive en
# secrets/, que NO se versiona. En docker lo monta el compose como secreto
# en /run/secrets/firebase-sa (ver docker-compose.yml).
FCM_CREDENTIALS_PATH=secrets/firebase-service-account.json
# Ruta del service account en el HOST: la que lee docker compose para montar
# el secreto. Ajustala si tu archivo se llama distinto.
FCM_CREDENTIALS_FILE=./secrets/firebase-service-account.json
FCM_PROJECT_ID=mi-proyecto-firebase


# ---------------------------------------------------------------------------
# Almacenamiento de imagenes (SeaweedFS)
# ---------------------------------------------------------------------------
# Endpoint PUBLICO de SeaweedFS usado para firmar las URLs de descarga de
# imagenes (los recibos). NO importa que sea alcanzable desde el backend: el
# que debe poder abrirlo es el CLIENTE (la app movil), porque el backend
# responde 302 hacia esta URL.
#
# La firma SigV4 incluye el HOST de esta URL, asi que debe ser EXACTAMENTE el
# host que ve el cliente (el del tunel). El tunel debe reenviar el header Host
# original (ngrok y cloudflared lo hacen) sin reescribir la ruta.
#
# Ejemplos segun como pruebes:
#   - Emulador Android con `adb reverse tcp:8081 tcp:8081`  -> http://localhost:8081
#   - Movil fisico en la misma red local (LAN)               -> http://<IP-DEL-PC>:8081
#   - Dev con ngrok (segundo tunel, al puerto 8081)          -> https://<storage>.ngrok-free.app
#   - Prod con Cloudflare (subdominio del storage)           -> https://storage.mis-monedas.com
#
# En dev el backend tambien va por tunel, pero en OTRO host: la app lo usa en
# local.properties (API_BASE_URL). Son DOS hosts distintos:
#   - API     -> puerto 8080  (ej. https://<api>.ngrok-free.app)
#   - Storage -> puerto 8081  (esta variable, servido por nginx)
SEAWEEDFS_PUBLIC_ENDPOINT=https://storage.mis-monedas.com

SEAWEEDFS_BUCKET=mi-bucket-imagenes
SEAWEEDFS_ACCESS_KEY_FILE=./secrets/seaweedfs_access_key
SEAWEEDFS_SECRET_KEY_FILE=./secrets/seaweedfs_secret_key


# ---------------------------------------------------------------------------
# RabbitMQ (cola OCR / notificaciones)
# ---------------------------------------------------------------------------
RABBITMQ_USER=mi_usuario
RABBITMQ_PASSWORD=REEMPLAZAR
